HOST=localhost
PORT=3333

# Postgres — durable metadata (tenants, API keys, rate-limit rules)
DATABASE_URL=postgresql://ratelimiter:ratelimiter@localhost:5432/ratelimiter?schema=public

# Redis — hot-path counters/state for the rate-limiting algorithms
REDIS_URL=redis://localhost:6379

# Pepper mixed into the HMAC-SHA256 hash of API keys before they're stored.
API_KEY_HASH_PEPPER=change-me-in-production

# Static token gating the tenant/API-key bootstrap endpoints (no self-service signup yet).
ADMIN_TOKEN=change-me-local-admin-token
