{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "nodenext",
    "types": ["node"],
    "rootDir": "src",
    "moduleResolution": "nodenext",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../packages/rate-limiter-backend/rules/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rate-limiter-backend/auth/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rate-limiter-backend/data-access/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rate-limiter-backend/rate-limit-engine/tsconfig.lib.json"
    }
  ]
}
