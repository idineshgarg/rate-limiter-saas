# Copy to .env.production on the deploy host, fill in real values, and never
# commit the filled-in file. Generate secrets with e.g. `openssl rand -hex 32`.

# Credentials for the postgres container itself.
POSTGRES_USER=ratelimiter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ratelimiter

# Consumed by the backend/migrate services — keep in sync with the
# POSTGRES_* values above.
DATABASE_URL=postgresql://ratelimiter:change-me@postgres:5432/ratelimiter?schema=public
REDIS_URL=redis://redis:6379

API_KEY_HASH_PEPPER=change-me
ADMIN_TOKEN=change-me
SESSION_SECRET=change-me

# Public origin the dashboard is served from — must match exactly (scheme +
# host) for credentialed CORS requests from the dashboard to the API to work.
CORS_ORIGIN=https://app.example.com

# Baked into the dashboard's JS bundle at build time. Leave unset/empty for
# same-origin (dashboard and API behind one proxy); set to the API's public
# origin when they're served from different hostnames.
VITE_API_URL=https://api.example.com
