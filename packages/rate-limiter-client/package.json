{
  "name": "@dineshgarg/rate-limiter-client",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@dg/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./express": {
      "@dg/source": "./src/express.ts",
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "default": "./dist/express.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "rate-limiter-client",
    "tags": [
      "scope:client"
    ]
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "express": "^4.21.2",
    "@types/express": "^4.17.21"
  },
  "peerDependencies": {
    "express": "^4.21.2"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
