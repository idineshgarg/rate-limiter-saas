{
  "name": "@dg/rate-limiter-backend-data-access",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "scope:rate-limiter-backend"
    ],
    "targets": {
      "build": {
        "dependsOn": ["prisma-generate"]
      },
      "typecheck": {
        "dependsOn": ["prisma-generate"]
      },
      "lint": {
        "dependsOn": ["prisma-generate"]
      },
      "test": {
        "dependsOn": ["prisma-generate"]
      },
      "prisma-generate": {
        "cache": true,
        "executor": "nx:run-commands",
        "inputs": ["{projectRoot}/prisma/schema.prisma"],
        "outputs": ["{projectRoot}/src/generated/prisma"],
        "options": {
          "cwd": "packages/rate-limiter-backend/data-access",
          "command": "prisma generate"
        }
      },
      "prisma-migrate": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/rate-limiter-backend/data-access",
          "command": "prisma migrate dev"
        }
      },
      "prisma-migrate-deploy": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/rate-limiter-backend/data-access",
          "command": "prisma migrate deploy"
        }
      }
    }
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.23.0",
    "dotenv": "^18.0.4"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0"
  }
}
